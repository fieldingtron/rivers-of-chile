---
import LookPreference from '../components/LookPreference.astro';
import LanguageChooser from '../components/LanguageChooser.astro';
import LanguagePreference from '../components/LanguagePreference.astro';
import { languageForPath } from '../lib/languages';
import SEO from '../components/SEO.astro';
interface Props { title: string; description?: string; image?: string; bodyClass?: string; }
const { title, description, image, bodyClass } = Astro.props;
---
<!doctype html>
<html lang={languageForPath(Astro.url.pathname)}>
  <head>
    <SEO title={title} description={description} image={image} />
    <LookPreference />
    <LanguagePreference />
  </head>
  <body class={bodyClass}>
    <slot />
    <LanguageChooser />
  </body>
</html>
<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; -webkit-font-smoothing: antialiased; }
  img { max-width: 100%; display: block; }
  a { text-decoration: none; }
</style>
