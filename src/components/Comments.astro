---
import CommentList from './CommentList.astro';
import type { CommentItem } from '../lib/directus';

interface Props { comments: CommentItem[] }
const { comments } = Astro.props;
---
<section class="comments" id="comments" aria-labelledby="comments-title">
  <h2 id="comments-title">{comments.length ? `${comments.length} ${comments.length === 1 ? 'comment' : 'comments'}` : 'Comments'}</h2>
  {comments.length > 0 && <CommentList comments={comments} />}
  <label for="new-comment">Add a comment</label>
  <textarea id="new-comment" rows="3" disabled aria-describedby="comment-availability"></textarea>
  <small id="comment-availability">New comments are closed for now.</small>
</section>
<style>
  section { margin-block-start: 2.5rem; padding-block-start: 1rem; border-top: 1px solid #ccc; }
  label, small { display: block; }
  label { font-weight: 600; }
  textarea { box-sizing: border-box; width: 100%; margin-block: .4rem; }
</style>
