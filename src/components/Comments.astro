---
import VisitorForm from './VisitorForm.astro';
import CommentList from './CommentList.astro';
import type { CommentItem } from '../lib/directus';
import { createSiteUI } from './site-ui';

interface Props { comments: CommentItem[]; slug: string; allowSubmission?: boolean }
const { comments, slug, allowSubmission = true } = Astro.props;
const { t } = createSiteUI(Astro.url.pathname);
const heading = comments.length
  ? `${comments.length} ${comments.length === 1 ? t('comment', 'comentario') : t('comments', 'comentarios')}`
  : t('Comments', 'Comentarios');
---
<section class="comments" id="comments" aria-labelledby="comments-title">
  <h2 id="comments-title">{heading}</h2>
  {comments.length > 0 && <CommentList comments={comments} />}
  {allowSubmission && <VisitorForm kind="comment" slug={slug} />}
</section>
<style>
  section { margin-block-start: 2.5rem; padding-block-start: 1rem; border-top: 1px solid #ccc; }
  label, small { display: block; }
  label { font-weight: 600; }
  textarea { box-sizing: border-box; width: 100%; margin-block: .4rem; }
</style>
