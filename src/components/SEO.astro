---
import { languages } from '../lib/languages';
import { createSiteUI } from './site-ui';
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { spanish: es, languageRoutes } = createSiteUI(Astro.url.pathname);
const production = Astro.site?.hostname === 'www.riversofchile.com';
const auxiliary = /\/(?:home-[23]|404(?:\.html)?|rio-claro-puente-las-pinas)\/?$/.test(Astro.url.pathname);
const base = Astro.site || Astro.url;
const {
  title,
  description = es ? 'Guía de kayak en aguas bravas de Chile, con descripciones de los ríos, información de acceso y fotografías.' : 'Kayakers guide to the whitewater of Chile: river descriptions, access notes, and photographs.',
  canonical = new URL(Astro.url.pathname, base).href,
  image,
  type = 'website'
} = Astro.props;

const siteName = 'Rivers of Chile';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{(!production || auxiliary) && <meta name="robots" content={production ? "noindex, follow" : "noindex, nofollow"} />}
<link rel="canonical" href={canonical} />

{languages.map(({code}) => <link rel="alternate" hreflang={code} href={new URL(languageRoutes[code], base)} />)}
<link rel="alternate" hreflang="x-default" href={new URL(languageRoutes.en, base)} />
<meta property="og:locale" content={es ? 'es_CL' : 'en_US'} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteName} />
{image && <meta property="og:image" content={image} />}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image} />}
