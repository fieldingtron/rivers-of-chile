---
import { riverPhotoAlt, riverPhotoLocation, type RiverPhoto } from '../lib/river-photos';
interface Props {
  photo: RiverPhoto;
  es: boolean;
  caption?: string;
}
const { photo, es, caption } = Astro.props;
const location = riverPhotoLocation(photo, es);
const match = es ? photo.matchEs || photo.match : photo.match;
const alt = caption && !photo.representative ? caption : riverPhotoAlt(photo, es);
const simpleCaption = caption && !photo.representative && !photo.licenseUrl && !photo.credit;
const label = simpleCaption ? caption : photo.title;
---
<figure class="river-feature">
  <a href={photo.full} data-lightbox data-full={photo.full} data-caption={label}>
    <img src={photo.image} alt={alt} width={photo.width} height={photo.height} decoding="async" fetchpriority="high" />
    <span>{es ? 'Ver foto completa' : 'View full photo'}</span>
  </a>
  {simpleCaption ? <figcaption>{caption}</figcaption> : photo.source && <figcaption>
    <a href={photo.source}>{photo.licenseUrl ? photo.title : 'Rivers of Chile'}</a>
    {photo.credit && <> · {photo.credit}</>}
    {photo.licenseUrl && <> · <a href={photo.licenseUrl} rel="license">{photo.license}</a> · {es ? 'Recorte horizontal' : 'Landscape crop'}</>}
    {location && <div>
      {photo.representative && <>{es ? 'Foto de referencia' : 'Representative photo'} · </>}
      {location}{match && <> · {match}</>}
    </div>}
    {photo.original && <a href={photo.original}>{es ? 'Archivo original' : 'Original file'}</a>}
  </figcaption>}
  {!simpleCaption && photo.description && <figcaption class="file-caption">{photo.description}</figcaption>}
</figure>
<style>
  .river-feature { max-width: 1100px; margin: 1rem auto; }
  .river-feature > a { display: block; position: relative; }
  .river-feature img { display: block; width: 100%; height: auto; }
  .river-feature span { position: absolute; right: .75rem; bottom: .75rem; background: #193d48; color: white; padding: .4rem .7rem; font: 500 .85rem system-ui; }
  .river-feature figcaption { margin: .45rem auto; text-align: center; font: .84rem/1.5 system-ui; }
  .river-feature .file-caption { white-space: pre-line; overflow-wrap: anywhere; }
</style>
