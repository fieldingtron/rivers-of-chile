---
import { createSiteUI } from './site-ui';
interface Props { kind: 'comment' | 'contact'; slug?: string }
const { kind, slug = '' } = Astro.props;
const { t, language } = createSiteUI(Astro.url.pathname);
const contact = kind === 'contact';
---
<form class="visitor-form" action={`/api/${kind}`} method="post" data-visitor-form>
  <input type="hidden" name="slug" value={slug} />
  <input type="hidden" name="ui" value={language} />
  <label>{t('Your name', 'Tu nombre')}<input name="name" maxlength="100" autocomplete="name" required /></label>
  <label>{t('Your email', 'Tu correo electrónico')}<input type="email" name="email" maxlength="254" autocomplete="email" required /></label>
  {contact && <label>{t('Subject (optional)', 'Asunto (opcional)')}<input name="subject" maxlength="150" /></label>}
  <label>{contact ? t('Message', 'Mensaje') : t('Add a comment', 'Escribe un comentario')}
    <textarea name="message" rows="4" maxlength="4000" required></textarea>
  </label>
  <label class="language">{t('Writing in', 'Idioma del mensaje')}
    <select name="language"><option value="en" selected={language === 'en'}>English</option><option value="es" selected={language === 'es'}>Español</option></select>
  </label>
  <label class="trap" aria-hidden="true">Website<input name="website" autocomplete="off" tabindex="-1" /></label>
  <small>{contact ? t('Your message goes privately to the site team.', 'Tu mensaje se envía en privado al equipo del sitio.') :
    t('Your email stays private. We’ll email you when your comment is approved or declined.', 'Tu correo es privado. Te avisaremos si se aprueba o se rechaza tu comentario.')}</small>
  <button type="submit">{contact ? t('Send message', 'Enviar mensaje') : t('Submit comment', 'Enviar comentario')}</button>
  <p class="result" role="status" aria-live="polite"></p>
</form>
<style>
  .visitor-form { display: grid; gap: .8rem; max-width: 38rem; margin: 1.25rem 0; font: 1rem/1.45 system-ui,sans-serif; }
  label { display: grid; gap: .25rem; font-weight: 600; }
  input, textarea, select { box-sizing: border-box; font: inherit; color: #172333; border: 1px solid #89929d; border-radius: .3rem; padding: .55rem; background: white; }
  textarea { resize: vertical; } .language { display:flex; gap:.5rem; align-items:center; font-size:.9rem; }
  .trap { position: absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }
  button { justify-self: start; background:#153c49; color:white; border:0; border-radius:.35rem; padding:.6rem 1rem; font:inherit; cursor:pointer; }
  button:disabled { opacity:.65; } .result {margin:0;} .result:empty {display:none;}
</style>
<script>
  document.querySelectorAll<HTMLFormElement>('form[data-visitor-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button')!;
      if (button.disabled) return;
      const output = form.querySelector<HTMLElement>('[role=status]')!;
      const es = document.documentElement.lang === 'es';
      button.disabled = true;
      output.textContent = es ? 'Enviando…' : 'Sending…';
      try {
        const response = await fetch(form.action, { method: 'POST', body: new URLSearchParams(Array.from(new FormData(form), ([key, value]) => [key, String(value)])), headers: { Accept: 'application/json' } });
        const result = await response.json();
        output.textContent = result.message;
        if (response.ok) form.reset();
      } catch {
        output.textContent = es ? 'No se pudo confirmar el envío. Revisa tu conexión.' : 'Delivery could not be confirmed. Check your connection.';
      } finally { button.disabled = false; }
    });
  });
</script>
