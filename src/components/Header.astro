---
import { createSiteUI } from './site-ui';
import LanguagePicker from './LanguagePicker.astro';
const navigationLabels: Record<string, string> = {"Rivers": "Ríos", "Map": "Mapa", "First descents": "Primeros descensos", "Dedication": "Dedicatoria", "Authors": "Autores"};
const { t, href, spanish } = createSiteUI(Astro.url.pathname);
const path = Astro.url.pathname;
const links = [
  { href: '/category/chile/', label: 'Rivers' },
  { href: '/map-of-chile/', label: 'Map' },
  { href: '/history-of-first-descents/', label: 'First descents' },
  { href: '/dedication/', label: 'Dedication' },
  { href: '/about-authors/', label: 'Authors' }
];
import HomeLinks from './HomeLinks.astro';
---
<header class="site-header">
  <div class="site-header-inner">
    <a class="site-title" href={href("/")}>
      <img src="/images/rivers-64x64.png" width="36" height="36" alt="" />
      <span>Rivers Of Chile</span>
    </a>
    <nav class="site-nav" aria-label={t("Primary","Principal")}>
      {links.map((link) => (
        <a href={href(link.href)} aria-current={path === href(link.href) ? 'page' : undefined}>{t(link.label, navigationLabels[link.label] || link.label)}</a>
      ))}
      <HomeLinks compact /><LanguagePicker compact />
    </nav>
  </div>
</header>
