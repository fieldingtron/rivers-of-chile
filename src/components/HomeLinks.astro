---
import { createSiteUI } from './site-ui';
const { t, href, spanish } = createSiteUI(Astro.url.pathname);
// "Home 1 | Home 2 | Home 3": links between the homepage design options.
const compact = Boolean(Astro.props.compact);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const opts = [
  { href: '/', label: 'Home 1', match: '/' },
  { href: '/home-2/', label: 'Home 2', match: '/home-2' },
  { href: '/home-3/', label: 'Home 3', match: '/home-3' }
];
---
<span class:list={["home-links", compact && "compact"]} aria-label={t("Homepage design options","Opciones de portada")}>
  {opts.map((o) => <a href={href(o.href)} aria-current={path === (href(o.href).replace(/\/$/, '') || '/') ? 'page' : undefined}>{t(o.label, o.label.replace('Home', 'Inicio'))}</a>)}
</span>
<style>
  .home-links { display: inline-flex; gap: 2px; align-items: center; padding: 3px; border: 1px solid currentColor; border-radius: 999px; opacity: .95; }
  .home-links a { color: inherit !important; text-decoration: none !important; font-size: 12px !important; font-weight: 600; letter-spacing: .02em; padding: 3px 9px; border-radius: 999px; white-space: nowrap; }
  .home-links a:hover { background: rgba(127,127,127,.28); }
  .home-links a[aria-current] { background: rgba(127,127,127,.35); box-shadow: inset 0 0 0 1px currentColor; }
  .home-links.compact { padding: 1px; opacity: .8; }
  .home-links.compact a { font-size: 10px !important; padding: 2px 6px; font-weight: 600; }
</style>
