---
import { createSiteUI } from '../site-ui';
import LanguagePicker from '../LanguagePicker.astro';
import { taxonomyName } from '../../lib/spanish';
const { t, href, spanish } = createSiteUI(Astro.url.pathname);
import HomeLinks from '../HomeLinks.astro';
import { regionGuideLabel, excerptOf, initials, authorLabel, imageAt, popularRivers, classBadgeColor, authorPhoto } from '../../lib/home';
const { posts } = Astro.props;
const rivers = posts.filter((p: any) => p.kind === 'river');
const popular = popularRivers(posts, 9);
const index = rivers.map((p: any) => ({ t: p.title, s: href(`/${p.slug}/`), r: (spanish ? taxonomyName(regionGuideLabel(p)) : regionGuideLabel(p)), c: p.class_label || '' }));
---
<header class="nav">
  <div class="nav-in">
    <a class="logo" href={href("/")}>
      <img src="/images/rivers-64x64.png" width="36" height="36" alt="" />
      <span>Rivers Of Chile</span>
    </a>
    <nav>
      <a href={href("/category/chile/")}>{t("Rivers", "Ríos")}</a>
      <a href="#search">{t("Search", "Buscar")}</a>
      <a href={href("/dedication/")}>{t("Dedication", "Dedicatoria")}</a>
      <a href={href("/about-authors/")}>{t("Authors", "Autores")}</a>
      <HomeLinks compact /><LanguagePicker compact />
    </nav>
  </div>
</header>
<section class="strip">
  <div class="strip-in">
    <form id="search" class="search" role="search" onsubmit="return false">
      <input id="q" type="search" placeholder={t("Search Posts....","Buscar en las guías…")} autocomplete="off" aria-label={t("Search posts","Buscar en las guías")} />
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
    </form>
    <ul id="results" class="results" hidden></ul>
  </div>
</section>
<main>
  <div class="head"><h2>{t("Popular Rivers", "Ríos populares")}</h2></div>
  <div class="grid">
    {popular.map((p: any) => {
      const photo = authorPhoto(p.author_name);
      const name = authorLabel(p.author_name);
      return (
      <article class="card">
        <a class="photo" href={href(`/${p.slug}/`)} tabindex="-1" aria-hidden="true">
          <img src={imageAt(p.featured_image_url, 560)} alt="" loading="lazy" decoding="async" />
        </a>
        <div class="body">
          <div class="meta">
            <p class="region">{(spanish ? taxonomyName(regionGuideLabel(p)) : regionGuideLabel(p))}</p>
            {p.class_label && <span class="badge" style={`background:${classBadgeColor(p.class_label)}`}>{t("Class", "Clase")} {p.class_label}</span>}
          </div>
          <h3><a href={href(`/${p.slug}/`)}>{p.title}</a></h3>
          <p class="ex">{excerptOf(p, 130)}</p>
          <div class="foot">
            <a class="more" href={href(`/${p.slug}/`)}>{t("Read More", "Leer más")}</a>
            <span class="by">
              {photo
                ? <img src={photo} alt="" width="32" height="32" />
                : <i>{initials(p.author_name)}</i>}
              <b>{name}</b>
            </span>
          </div>
        </div>
      </article>
      );
    })}
  </div>
</main>
<footer class="foot-bar"><span>{t("Rivers of Chile — a field guide.", "Rivers of Chile — guía de ríos.")}</span><nav><a href={href("/dedication/")}>{t("Dedication", "Dedicatoria")}</a><a href={href("/about-authors/")}>{t("Authors", "Autores")}</a><a href={href("/hardcopy-guidebook/")}>{t("Hardcopy guidebook", "Guía impresa")}</a><a href={href('/contact-us/')}>{t('Contact', 'Contacto')}</a> <LanguagePicker /></nav></footer>
<script type="application/json" id="idx" set:html={JSON.stringify(index).replaceAll('<', '\\u003c')} />
<script define:vars={{ spanish }}>
  const idx = JSON.parse(document.getElementById('idx').textContent);
  const q = document.getElementById('q'), out = document.getElementById('results');
  q.addEventListener('input', () => {
    const v = q.value.trim().toLowerCase();
    if (v.length < 2) { out.hidden = true; out.innerHTML = ''; return; }
    const hits = idx.filter((r) => (r.t + ' ' + r.r + (spanish ? ' clase ' : ' class ') + r.c).toLowerCase().includes(v)).slice(0, 8);
    out.replaceChildren(...hits.map((r) => {
      const li = document.createElement('li'), link = document.createElement('a');
      const name = document.createElement('b'), meta = document.createElement('span');
      link.href = r.s;
      name.textContent = r.t;
      meta.textContent = r.r + (r.c ? (spanish ? ' · Clase ' : ' · Class ') + r.c : '');
      link.append(name, meta); li.append(link); return li;
    }));
    if (!hits.length) {
      const empty = document.createElement('li'); empty.className = 'none';
      empty.textContent = spanish ? 'No se encontraron ríos.' : 'No rivers match.'; out.append(empty);
    }
    out.hidden = false;
  });
</script>
<style>
  :global(body.v-a) { font-family: Inter, system-ui, -apple-system, "Segoe UI", sans-serif; background: #f3f4f6; color: #111827; margin: 0; }
  .nav { background: #111827; color: #fff; }
  .nav-in { max-width: 1180px; margin: 0 auto; padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .logo { display: flex; align-items: center; gap: 10px; color: #fff; font-weight: 700; font-size: 18px; letter-spacing: .01em; text-decoration: none; }
  .logo img { width: 36px; height: 36px; border-radius: 6px; display: block; }
  .nav nav { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  .nav nav > a { color: #fff; font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; text-decoration: none; }
  .nav nav > a:hover { color: #e5e7eb; }
  .strip { background: #4b5563; padding: 14px 24px; }
  .strip-in { max-width: 1180px; margin: 0 auto; position: relative; display: flex; justify-content: flex-end; }
  .search { display: flex; align-items: center; gap: 8px; background: #fff; color: #111; border-radius: 999px; padding: 2px 14px 2px 18px; width: min(340px, 100%); box-shadow: 0 1px 2px rgba(0,0,0,.12); }
  .search input { flex: 1; border: 0; outline: 0; font: inherit; font-size: 14px; padding: 8px 0; background: transparent; min-width: 0; }
  .search input::placeholder { color: #9ca3af; }
  .search svg { flex: none; color: #111; }
  .results { position: absolute; right: 0; top: calc(100% + 8px); width: min(340px, 100%); background: #fff; color: #111827; border-radius: 12px; list-style: none; margin: 0; padding: 6px; text-align: left; box-shadow: 0 18px 40px rgba(0,0,0,.28); z-index: 10; }
  .results a { display: flex; justify-content: space-between; gap: 12px; padding: 10px 12px; color: inherit; border-radius: 8px; text-decoration: none; }
  .results a:hover { background: #f3f4f6; }
  .results span { color: #6b7280; font-size: 13px; }
  .results .none { padding: 12px; color: #6b7280; }
  main { max-width: 1180px; margin: 0 auto; padding: 0 24px 64px; }
  .head { margin: 0 0 22px; padding-top: 36px; border-bottom: 1px solid #d1d5db; }
  .head h2 { margin: 0 0 10px; font-size: 28px; font-weight: 800; color: #111; letter-spacing: -.01em; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 28px; }
  .card { background: #fff; border-radius: 10px; box-shadow: 0 1px 2px rgba(0,0,0,.06), 0 8px 20px rgba(17,24,39,.08); display: flex; flex-direction: column; padding: 12px 12px 16px; }
  .photo { display: block; aspect-ratio: 16/10; background: #e5e7eb; overflow: hidden; border-radius: 6px; }
  .photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .body { padding: 14px 6px 0; display: flex; flex-direction: column; flex: 1; }
  .meta { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 0 10px; }
  .region { margin: 0; color: #6b7280; font-size: 13px; }
  .badge { color: #fff; font-weight: 700; font-size: 11px; padding: 4px 9px; border-radius: 4px; letter-spacing: .02em; white-space: nowrap; }
  h3 { margin: 0 0 8px; font-size: 20px; line-height: 1.25; font-weight: 800; }
  h3 a { color: #111; text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .ex { color: #6b7280; font-size: 14px; line-height: 1.55; margin: 0 0 16px; flex: 1; }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .more { color: #374151; font-size: 14px; text-decoration: none; }
  .more:hover { text-decoration: underline; }
  .by { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #111; }
  .by img, .by i { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; flex: none; }
  .by i { font-style: normal; background: #111827; color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 11px; }
  .by b { font-weight: 700; }
  .foot-bar { background: #111827; color: #9ca3af; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding: 22px max(24px, calc((100% - 1132px)/2)); font-size: 14px; }
  .foot-bar nav { display: flex; align-items: center; flex-wrap: wrap; gap: 18px; } .foot-bar a { color: #fff; text-decoration: none; }
  @media (max-width: 640px) { .nav nav { gap: 14px; } .search, .results { width: 100%; } }
</style>
