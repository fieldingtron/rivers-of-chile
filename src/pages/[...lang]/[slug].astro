---
import { languages, languageForPath, languagePrefix } from '../../lib/languages';
import { taxonomyName, localizedBodyLinks } from '../../lib/spanish';
import { publicSlug, guideHeading, guideLinks, guideDescription } from '../../lib/guide-seo';
import { reviewedEnglishLinks } from '../../lib/reviewed-links.mjs';
import { formatFirstDescents } from '../../lib/first-descents.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RegionMap from '../../components/RegionMap.astro';
import VisitorForm from '../../components/VisitorForm.astro';
import Comments from '../../components/Comments.astro';
import RiverFeaturedPhoto from '../../components/RiverFeaturedPhoto.astro';
import RiverGuideOpening from '../../components/RiverGuideOpening.astro';
import { gradeLabel, gradeTags, classNumeral, guideIntro, guideWaterSource } from '../../lib/river-guide.mjs';
import { guideRegion, bullileoBody } from '../../lib/guide-regions';
import '../../styles/river-guide.css';
import { riverPhoto, riverPhotoAlt } from '../../lib/river-photos';
import RiverCards from '../../components/RiverCards.astro';
import { relatedGuides } from '../../lib/related-guides';
import { pageDate } from '../../lib/page-date';
import Lightbox from '../../components/Lightbox.astro';
import { getPosts, getPages, getComments, type CommentItem, getCategories, RESERVED_SLUGS, type PostItem, type PageItem } from '../../lib/directus';
import { loadImageManifest, prepareArticleImages, featuredImageUrl, publicBase, HERO_SIZES, assetFor, pickDisplay, displayVariants, variantUrl, isPlaceholderFeatured } from '../../lib/legacy-images.mjs';
import { rewriteDirectusAssets } from '../../lib/file-registry.mjs';
import { regionGuideLabel, regionLabel, authorLabel } from '../../lib/home';

export async function getStaticPaths() {
  const routes = await Promise.all(languages.map(async ({ code, prefix }) => {
    const lang = prefix.slice(1) || undefined;
    const [posts, pages, comments] = await Promise.all([getPosts(code), getPages(code), getComments()]);
    const rivers = posts.filter(p => p.kind === 'river');
    const used = new Set(RESERVED_SLUGS);
    const publicSlugs = new Set(RESERVED_SLUGS);
    const pageSlugs = new Set(pages.map((p) => p.slug));
    const paths: { params: { lang: string | undefined; slug: string }; props: Props }[] = [];

    for (const item of [...pages, ...posts]) {
      if (!item.slug || used.has(item.slug)) continue;
      used.add(item.slug);
      const slug = publicSlug(item.slug);
      if (publicSlugs.has(slug)) throw new Error('Conflicting public route: ' + slug);
      publicSlugs.add(slug);
      const type = pageSlugs.has(item.slug) ? 'page' : 'post';
      paths.push({
        params: { lang, slug },
        props: { type, item, related: type === 'post' && (item as PostItem).kind === 'river' ? relatedGuides(item as PostItem, rivers) : undefined, comments: comments.filter(c =>
          c[type]?.slug === item.slug || (type === 'post' && (item as PostItem).kind !== 'river' && c.page?.slug === item.slug)
        ) }
      });
    }
    const history = paths.find(({ props }) => props.type === 'page' && props.item.slug === 'history-of-first-descents');
    if (history) {
      history.props.descentGuidePaths = new Map<string, string>(paths.flatMap(({ params, props }) =>
        props.type === 'post' && (props.item as PostItem).kind === 'river'
          ? [[props.item.slug, `${prefix}/${params.slug}/`]]
          : []
      ));
    }
    return paths;
  }));
  return routes.flat();
}

interface Props {
  type: 'post' | 'page';
  item: PostItem | PageItem;
  comments: CommentItem[];
  related?: ReturnType<typeof relatedGuides>;
  descentGuidePaths?: Map<string, string>;
}

const language = languageForPath(Astro.url.pathname);
const prefix = languagePrefix(language);
const es = language === 'es';
const { type, item, comments, related, descentGuidePaths } = Astro.props;
const post = type === 'post' ? (item as PostItem) : null;
const river = post?.kind === 'river' ? post : null;
const bullileo = river?.slug === 'rio-bullileo';
const categories = post ? await getCategories(es) : [];
const catNames = post
  ? (post.legacy_categories || []).map((slug) => categories.find((c) => c.slug === slug)).filter(Boolean)
  : [];
const openLinksInNewWindow = !es && item.slug === '22-teacups-22-tazas-rio-claro';
const facts = post && !river ? [
  {label: es ? 'Clase' : 'Class', value: post.class_label, archive: catNames.find(c => c?.type === 'class')?.slug},
  {label: es ? 'Región' : 'Region', value: post.region && (es ? taxonomyName(regionGuideLabel(post)) : regionGuideLabel(post)), archive: catNames.find(c => c?.slug === post.region)?.slug},
  {label: es ? 'País' : 'Country', value: post.country && post.country.charAt(0).toUpperCase() + post.country.slice(1)},
  {label: es ? 'Temporada' : 'Season', value: post.season},
  {label: es ? 'Distancia' : 'Distance', value: post.length_km != null ? post.length_km + ' km' : null},
  {label: es ? 'Pendiente' : 'Gradient', value: post.gradient}
].filter(f => f.value) : [];
const isRiverMap = item.slug === 'map-of-chile';
const heading = isRiverMap ? (es ? 'Regiones fluviales de Chile' : 'River regions of Chile') : bullileo ? 'Río Bullileo' : guideHeading(item.slug, item.title);
const description = guideDescription(item, heading, es);
const legacyTitle = item.seo_title?.replace(/\s*[-|]\s*(?:peruwhitewater\.com|rivers of chile)\s*$/i, '').trim();
const title = post?.kind === 'river'
  ? (es ? heading + ' — Guía de kayak' : heading + ' kayaking guide')
  : isRiverMap ? heading : legacyTitle || heading;
const images = loadImageManifest();
const selection = post?.kind === 'river' ? riverPhoto(post) : undefined;
const region = river ? guideRegion(river) : undefined;
const place = region === 'nuble' ? 'Ñuble' : region && river ? regionLabel({ ...river, region }) : undefined;
const grade = river ? gradeLabel(river) : undefined;
const classArchive = river && gradeTags(river).filter(tag => categories.some(category => category.slug === tag)).at(-1);
const regionArchive = region && categories.some(category => category.slug === region) ? region : undefined;
const intro = bullileo
  ? es
    ? 'Aguas abajo del embalse Bullileo, cerca de Parral, el descenso comienza con unos 2 km de fuerte pendiente. Sigue un tramo más tranquilo antes de que el río vuelva a ganar pendiente cerca de la confluencia con el Longaví.'
    : 'Below Embalse Bullileo near Parral, the run opens with about 2 km of steep creeking. A gentler middle stretch follows before the river steepens again near the confluence with the Longaví.'
  : river ? guideIntro(river.content, language, es ? undefined : river.excerpt) : undefined;
const length = bullileo ? (es ? '9,5 km (según la guía)' : '9.5 km (reported)')
  : river?.length_km && Number(river.length_km) > 0 ? new Intl.NumberFormat(language).format(river.length_km) + ' km' : undefined;
const guideFacts = [
  { label: es ? 'Dificultad' : 'Difficulty', value: grade && (es ? 'Clase ' : 'Class ') + grade, href: classArchive ? prefix + '/category/' + classArchive + '/' : undefined },
  { label: es ? 'Longitud del tramo' : 'Run length', value: length },
  { label: es ? 'Origen del caudal' : 'Water source', value: bullileo ? (es ? 'Descarga del embalse y caudal natural' : 'Dam release and natural flow') : guideWaterSource(river?.content, es) },
  { label: es ? 'Región' : 'Region', value: place, href: regionArchive ? prefix + '/category/' + regionArchive + '/' : undefined }
].filter((fact): fact is { label: string; value: string; href?: string } => Boolean(fact.value));
const featured = post?.featured_image_url || undefined;
const image = selection?.image || featuredImageUrl(images, featured) || featured || undefined;
const rawBody = item.content || '';
const preparedBody = prepareArticleImages(rewriteDirectusAssets(bullileo ? bullileoBody(rawBody) : rawBody, publicBase(images)), images);
const body = item.slug === 'contact-us' ? '' : localizedBodyLinks(preparedBody, prefix);
const linkedBody = es ? guideLinks(body) : reviewedEnglishLinks(guideLinks(body), item.slug);
const articleBody = descentGuidePaths ? formatFirstDescents(linkedBody, descentGuidePaths) : linkedBody;
const featuredAsset = featured ? assetFor(images, featured) : undefined;
const featuredDisplay = featuredAsset ? pickDisplay(featuredAsset) : undefined;
const featuredAlreadyInBody = !!(featuredAsset?.variants || []).some((v: { key?: string }) => {
  const name = String(v.key || '').split('/').pop();
  return name && (body.includes(name) || (item.content || '').includes(name));
});
const showHero = Boolean(image && featuredAsset && !featuredAlreadyInBody && !isPlaceholderFeatured(featured, featuredAsset));
const heroSrcset = showHero && featuredAsset && images
  ? displayVariants(featuredAsset).map((v: { key: string; width: number }) => `${variantUrl(images, v)} ${v.width}w`).join(', ')
  : undefined;
const article = post && {
  '@context': 'https://schema.org',
  '@type': 'Article',
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  headline: heading,
  description,
  inLanguage: language,
  image: image ? new URL(image, Astro.site).href : undefined,
  author: post.author_name ? { '@type': 'Person', name: authorLabel(post.author_name) } : undefined,
  publisher: { '@type': 'Organization', name: 'Rivers of Chile' },
  datePublished: post.published_at || undefined,
  dateModified: post.updated_at || undefined
};
---
<BaseLayout
  mainClass={river ? 'river-guide-main' : undefined}
  openLinksInNewWindow={openLinksInNewWindow}
  title={title}
  breadcrumb={heading}
  description={description}
  type={type === 'post' ? 'article' : 'website'}
  image={image}
  imageAlt={selection ? riverPhotoAlt(selection, es) : undefined}
>
  {article && <script type="application/ld+json" set:html={JSON.stringify(article).replace(/</g, '\\u003c')} />}
  <article class:list={['prose', river && 'river-guide']}>
    <div class={river ? 'guide-opening-frame' : 'prose-header'}>
      {river ? (
        <RiverGuideOpening heading={heading} intro={intro} facts={guideFacts} es={es}>
          {selection && <RiverFeaturedPhoto slot="photo" photo={selection} es={es} caption={bullileo ? 'Río Bullileo' : undefined} />}
          {!selection && image && (
            <figure slot="photo" class="guide-fallback-photo">
              <a href={image} data-lightbox data-full={image} data-caption={heading}>
                <img src={image} alt={heading} decoding="async" fetchpriority="high" />
              </a>
            </figure>
          )}
        </RiverGuideOpening>
      ) : <h1 class="page-title">{heading}</h1>}
      {post && (post.author_name || post.published_at) && <p class="meta-line">
        {post.author_name && authorLabel(post.author_name)}
        {post.author_name && post.published_at && ' · '}
        {post.published_at && <time datetime={post.published_at}>{pageDate(post.published_at, language)}</time>}
      </p>}
    </div>
    {post && (facts.length > 0 || post.put_in || post.take_out) && <div class={river ? undefined : 'guide-opening'}>
      <div>
        {facts.length > 0 && <dl class="summary-grid">{facts.map(fact => <div>
          <dt>{fact.label}</dt><dd>{fact.archive ? <a href={prefix+'/category/'+fact.archive+'/'}>{fact.value}</a> : fact.value}</dd>
        </div>)}</dl>}
        {(post.put_in || post.take_out) && <section>
          <h2>{es ? 'Accesos' : 'River access'}</h2>
          <dl class="summary-grid">
            {post.put_in && <div><dt>{es ? 'Embarque' : 'Put-in'}</dt><dd>{post.put_in}</dd></div>}
            {post.take_out && <div><dt>{es ? 'Desembarque' : 'Take-out'}</dt><dd>{post.take_out}</dd></div>}
          </dl>
        </section>}
      </div>
    </div>}
    {!river && showHero && (
      <figure class="hero">
        <img
          src={featuredDisplay && images ? variantUrl(images, featuredDisplay) : image}
          alt={item.title}
          width={featuredDisplay?.width}
          height={featuredDisplay?.height}
          sizes={HERO_SIZES}
          srcset={heroSrcset}
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    )}
    {post?.kind === 'river' && body.trim() && <h2 class="run-heading">{es ? 'El recorrido' : 'The run'}</h2>}
    {isRiverMap ? <RegionMap /> : <div class:list={['article-body', { 'first-descents': descentGuidePaths }]} set:html={articleBody} />}
    {related && <div class="related-rivers">
      {related.nearby.length > 0 && <section>
        <h2>{place ? (es ? 'Más ríos en ' : 'More rivers in ') + place : (es ? 'Más ríos de la región' : 'More rivers in this region')}</h2>
        <RiverCards posts={related.nearby} hideRegion related />
      </section>}
      {related.similar.length > 0 && <section>
        <h2><a href={prefix+'/category/'+related.grade+'/'}>{(es ? 'Más ríos de clase ' : 'More Class ') + classNumeral(related.grade) + (es ? '' : ' rivers')}</a></h2>
        <RiverCards posts={related.similar} related />
      </section>}
    </div>}
    {catNames.length > 0 && (
      <p class="meta-line">
        {es ? 'Categorías:' : 'Categories:'}
        {catNames.map((c, i) => (
          <>
            {i > 0 && ', '}
            <a href={`${prefix}/category/${c!.slug}/`}>{c!.name}</a>
          </>
        ))}
      </p>
    )}
    {item.slug === 'contact-us' && <VisitorForm kind="contact" />}
    {!isRiverMap && (item.slug !== 'contact-us' || comments.length > 0) && (
      <Comments comments={comments} slug={item.slug} allowSubmission={item.slug !== 'contact-us'} />
    )}
  </article>
  {!openLinksInNewWindow && <Lightbox />}
</BaseLayout>

<style>
  .first-descents > :global(hr) {
    border: 0;
    border-block-start: 1px solid var(--line);
    margin: 1.25rem 0;
  }

  .first-descents :global(.descent-entry > h3) {
    font-size: var(--step-1);
    margin: 0 0 0.4rem;
  }

  .first-descents :global(.descent-entry > p:last-child) {
    margin-bottom: 0;
  }
</style>
