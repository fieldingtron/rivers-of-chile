---
import { languageForPath, languages, languagePrefix } from '../../../lib/languages';
import { publicSlug, guideHeading } from '../../../lib/guide-seo';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { tagPathSlug, getTags, getPosts } from '../../../lib/directus';

export async function getStaticPaths() {
  const routes = await Promise.all(languages.map(async ({ code, prefix }) => {
    const lang = prefix.slice(1) || undefined;
    const es = code === 'es';
    const [tags, posts] = await Promise.all([getTags(es), getPosts(code)]);
    return tags
      .filter((t) => t.slug)
      .map((tag) => ({
        params: { lang, slug: tagPathSlug(tag.slug) },
        props: {
          tag,
          posts: posts.filter((p) => (p.legacy_tags || []).includes(tag.slug))
        }
      }));
  }));
  return routes.flat();
}

const language = languageForPath(Astro.url.pathname);
const es = language === 'es';
const prefix = languagePrefix(language);
const { tag, posts } = Astro.props;
const examples = posts.slice(0, 3).map(post => guideHeading(post.slug, post.title));
const listing = new Intl.ListFormat(language).format(examples);
const description = es
  ? `Explora las entradas sobre ${tag.name}${listing ? ', entre ellas ' + listing : ''}.`
  : `Browse entries for ${tag.name}${listing ? ', including ' + listing : ''}.`;
---
<BaseLayout breadcrumb={tag.name} title={tag.name} description={description}>
  <h1 class="page-title">{tag.name}</h1>
  <p class="lede">{posts.length} {es ? (posts.length === 1 ? 'entrada' : 'entradas') : (posts.length === 1 ? 'entry' : 'entries')}.</p>
  <ul class="river-list">
    {posts.map((post) => (
      <li>
        <a href={`${prefix}/${publicSlug(post.slug)}/`}>
          <strong>{guideHeading(post.slug, post.title)}</strong>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
