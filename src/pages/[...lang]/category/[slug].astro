---
import { languageForPath, languages, languagePrefix } from '../../../lib/languages';
import { publicSlug, guideHeading } from '../../../lib/guide-seo';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCategories, getPosts } from '../../../lib/directus';

export async function getStaticPaths() {
  const routes = await Promise.all(languages.map(async ({ code, prefix }) => {
    const lang = prefix.slice(1) || undefined;
    const es = code === 'es';
    const [categories, posts] = await Promise.all([getCategories(es), getPosts(code)]);
    return categories
      .filter((c) => c.slug && c.slug !== 'uncategorized')
      .map((category) => ({
        params: { lang, slug: category.slug },
        props: {
          category,
          posts: posts.filter((p) => (p.legacy_categories || []).includes(category.slug))
        }
      }));
  }));
  return routes.flat();
}

const language = languageForPath(Astro.url.pathname);
const es = language === 'es';
const prefix = languagePrefix(language);
const { category, posts } = Astro.props;
const examples = posts.slice(0, 3).map(post => guideHeading(post.slug, post.title));
const listing = new Intl.ListFormat(language).format(examples);
const description = es
  ? `Explora las entradas sobre ${category.name}${listing ? ', entre ellas ' + listing : ''}.`
  : `Browse entries for ${category.name}${listing ? ', including ' + listing : ''}.`;
---
<BaseLayout breadcrumb={category.name} title={category.name} description={description}>
  <h1 class="page-title">{category.name}</h1>
  <p class="lede">{posts.length} {es ? (posts.length === 1 ? 'entrada' : 'entradas') : (posts.length === 1 ? 'entry' : 'entries')}.</p>
  <ul class="river-list">
    {posts.map((post) => (
      <li>
        <a href={`${prefix}/${publicSlug(post.slug)}/`}>
          <strong>{guideHeading(post.slug, post.title)}</strong>
          <div class="meta">
            {post.class_label && <span>{es ? 'Clase' : 'Class'} {post.class_label}</span>}
            {post.author_name && <span> · {post.author_name}</span>}
          </div>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
