---
import { languageForPath, languages, languagePrefix } from '../../../lib/languages';
import GuideFilters from '../../../components/GuideFilters.astro';
import { guideRegions, guideClasses } from '../../../lib/home';
import RiverCards from "../../../components/RiverCards.astro";
import { guideHeading, publicSlug } from '../../../lib/guide-seo';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCategories, getPosts } from '../../../lib/directus';

export async function getStaticPaths() {
  const routes = await Promise.all(languages.map(async ({ code, prefix }) => {
    const lang = prefix.slice(1) || undefined;
    const es = code === 'es';
    const [categories, posts] = await Promise.all([getCategories(es), getPosts(code)]);
    return categories
      .filter((c) => c.slug && c.slug !== 'uncategorized')
      .map((category) => ({
        params: { lang, slug: category.slug },
        props: {
          category,
          posts: posts.filter(p => {
            if (p.kind === 'river' && category.type === 'region') return guideRegions(p).includes(category.slug);
            if (p.kind === 'river' && category.type === 'class') return guideClasses(p).includes(category.slug);
            return p.legacy_categories?.includes(category.slug);
          })
        }
      }));
  }));
  return routes.flat();
}

const language = languageForPath(Astro.url.pathname);
const es = language === 'es';
const prefix = languagePrefix(language);
const { category, posts } = Astro.props;
const examples = posts.slice(0, 3).map(post => guideHeading(post.slug, post.title));
const listing = new Intl.ListFormat(language).format(examples);
const description = es
  ? `Explora las entradas sobre ${category.name}${listing ? ', entre ellas ' + listing : ''}.`
  : `Browse entries for ${category.name}${listing ? ', including ' + listing : ''}.`;
---
<BaseLayout title={category.name} description={description}>
  <h1 class="page-title">{category.name}</h1>
  <p class="lede">{posts.length} {es ? (posts.length === 1 ? 'entrada' : 'entradas') : (posts.length === 1 ? 'entry' : 'entries')}</p>
  <nav class="browse-links" aria-label={es ? 'Explorar ríos' : 'Browse rivers'}>
    <a href={prefix + '/region/'}>{es ? 'Por región' : 'By region'}</a>
    <a href={prefix + '/class/'}>{es ? 'Por dificultad' : 'By difficulty'}</a>
    <a href={prefix + '/map-of-chile/'}>{es ? 'Mapa de ríos' : 'River map'}</a>
  </nav>
  {posts.some(p => p.kind !== 'river') && <ul>{posts.filter(p => p.kind !== 'river').map(p =>
    <li><a href={prefix+'/'+publicSlug(p.slug)+'/'}>{p.title}</a></li>)}</ul>}
  {category.type === 'region' && <GuideFilters posts={posts.filter(p => p.kind === 'river')} />}
  <RiverCards posts={posts.filter(p => p.kind === 'river')} hideRegion={category.type === 'region'} />
</BaseLayout>
