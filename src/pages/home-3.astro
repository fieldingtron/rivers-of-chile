---
import { getPosts } from '../lib/directus';
import BareLayout from '../layouts/BareLayout.astro';
import HomeC from '../components/home/HomeC.astro';

const posts = await getPosts();
---
<BareLayout title="Rivers of Chile — Home 3" description="A kayaker’s river guide to Chile: first-hand river reports, access notes and photographs." bodyClass="v-c">
  <HomeC posts={posts} />
</BareLayout>
