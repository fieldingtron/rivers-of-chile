---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tagPathSlug, getTags, getPosts } from '../../lib/directus';

export async function getStaticPaths() {
  const [tags, posts] = await Promise.all([getTags(), getPosts()]);
  return tags
    .filter((t) => t.slug)
    .map((tag) => ({
      params: { slug: tagPathSlug(tag.slug) },
      props: {
        tag,
        posts: posts.filter((p) => (p.legacy_tags || []).includes(tag.slug))
      }
    }));
}

const { tag, posts } = Astro.props;
---
<BaseLayout title={tag.name} description={`Entries tagged ${tag.name}.`}>
  <h1 class="page-title">{tag.name}</h1>
  <p class="lede">{posts.length} {posts.length === 1 ? 'entry' : 'entries'}.</p>
  <ul class="river-list">
    {posts.map((post) => (
      <li>
        <a href={`/${post.slug}/`}>
          <strong>{post.title}</strong>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
